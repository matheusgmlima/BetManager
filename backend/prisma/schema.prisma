generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum BetResult {
  won
  lost
  void
  pending
}

enum BetType {
  simple
  combined
}

enum BetSource {
  manual
  ai_extract
}

// ─── Esportes ─────────────────────────────────────────────────────────────────

model Sport {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  icon      String?  @db.VarChar(50)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  bets Bet[]

  @@map("sports")
}

// ─── Casas de Apostas ─────────────────────────────────────────────────────────

model Bookmaker {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  color     String   @default("#6B7280") @db.VarChar(7)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  bets Bet[]

  @@map("bookmakers")
}

// ─── Grupos de Apostas Combinadas ─────────────────────────────────────────────

model CombinedBetGroup {
  id            Int       @id @default(autoincrement())
  date          DateTime  @db.Date
  totalOdds     Decimal?  @db.Decimal(10, 4) @map("total_odds")
  amountWagered Decimal   @db.Decimal(10, 2) @map("amount_wagered")
  payout        Decimal   @default(0) @db.Decimal(10, 2)
  result        BetResult @default(pending)
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  selections Bet[]

  @@map("combined_bet_groups")
}

// ─── Apostas ──────────────────────────────────────────────────────────────────

model BettingProfile {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(100)
  active        Boolean   @default(true)
  created_at    DateTime  @default(now()) @map("created_at")
  bets Bet[]

  @@map("betting_profiles")
}

model Bet {
  id            Int       @id @default(autoincrement())

  // Relacionamentos
  sportId       Int?      @map("sport_id")
  sport         Sport?    @relation(fields: [sportId], references: [id])

  bookmakerId   Int       @map("bookmaker_id")
  bookmaker     Bookmaker @relation(fields: [bookmakerId], references: [id])

  bettingProfileId  Int?              @map("betting_profile_id")
  bettingProfile    BettingProfile?   @relation(fields: [bettingProfileId], references: [id])

  combinedId    Int?      @map("combined_id")
  combined      CombinedBetGroup? @relation(fields: [combinedId], references: [id])

  // Dados da aposta
  date          DateTime  @db.Date
  description   String    @db.VarChar(500)
  betType       BetType   @default(simple) @map("bet_type")
  isCombined    Boolean   @default(false) @map("is_combined")

  // Valores financeiros
  amountWagered Decimal   @db.Decimal(10, 2) @map("amount_wagered")
  odds          Decimal?  @db.Decimal(10, 4)
  payout        Decimal   @default(0) @db.Decimal(10, 2)

  // Resultado
  result        BetResult @default(pending)

  // Metadados
  notes         String?
  source        BetSource @default(manual)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([date(sort: Desc)])
  @@index([result])
  @@index([sportId])
  @@index([bookmakerId])
  @@index([betType])
  @@map("bets")
  @@index([bettingProfileId])
}

// ─── Metas ────────────────────────────────────────────────────────────────────

model Goal {
  id            Int      @id @default(autoincrement())
  month         Int      @db.SmallInt
  year          Int      @db.SmallInt
  targetProfit  Decimal  @db.Decimal(10, 2) @map("target_profit")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([month, year])
  @@map("goals")
}

// ─── Log de Extrações por IA ──────────────────────────────────────────────────

model AiExtractionLog {
  id             Int      @id @default(autoincrement())
  modelUsed      String   @db.VarChar(50) @map("model_used")
  betsDetected   Int      @default(0) @map("bets_detected")
  betsConfirmed  Int      @default(0) @map("bets_confirmed")
  inputTokens    Int?     @map("input_tokens")
  outputTokens   Int?     @map("output_tokens")
  success        Boolean  @default(true)
  errorMessage   String?  @map("error_message")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("ai_extraction_logs")
}
